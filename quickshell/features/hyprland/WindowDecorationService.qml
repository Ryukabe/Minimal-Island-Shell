// features/hyprland/WindowDecorationService.qml — writes the Windows settings to Hyprland.
// ShellState holds the values (the shadow color is shared with the island, from Colors). This
// turns them into modules/decoration/window.lua (loaded by Hyprland at startup) and pushes them
// to the running compositor with `hyprctl eval`. window.lua is the only place these options are
// defined — never edit it by hand.
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import "../../core/shell"
import "../../core/styles"
import "../settings/core"

Item {
    id: root

    readonly property string dir: Quickshell.env("HOME") + "/.config/hypr/modules/decoration"
    readonly property string path: root.dir + "/window.lua"

    // Nothing is written until window.lua has been read AND SettingsStore has loaded the saved
    // values, so the defaults never reach Hyprland for a moment at startup.
    property bool _fileLoaded: false
    readonly property bool _ready: root._fileLoaded && SettingsStore._loaded
    property string _written: ""
    property bool _evalPending: false

    readonly property string signature: [
        ShellState.windowRounding, ShellState.windowRoundingPower,
        ShellState.windowGapsIn, ShellState.windowGapsOut, ShellState.windowBorderSize,
        ShellState.windowActiveOpacity, ShellState.windowInactiveOpacity,
        ShellState.windowFullscreenOpacity,
        ShellState.windowDimInactive, ShellState.windowDimStrength,
        ShellState.windowShadowEnabled, ShellState.windowShadowRange,
        ShellState.windowShadowPower, ShellState.windowShadowScale,
        ShellState.windowShadowOpacity, String(Colors.shadowColor)
    ].join("|")

    onSignatureChanged: root._schedule()
    on_ReadyChanged: if (root._ready) root._schedule()

    function _schedule() {
        if (root._ready) applyTimer.restart()
    }

    function _num(v) {
        const s = Number(Number(v).toFixed(4)).toString()
        return s.indexOf(".") < 0 ? s + ".0" : s
    }

    function _bool(v) { return v ? "true" : "false" }

    // Colors.shadowColor can read back as #rrggbb or #aarrggbb. Hyprland wants rgba(rrggbbaa),
    // with the alpha coming from the Window shadow opacity slider.
    function _shadowRgba() {
        let hex = String(Colors.shadowColor).replace("#", "").toLowerCase()
        if (hex.length === 8) hex = hex.substring(2)
        if (hex.length !== 6) hex = "000000"
        let a = Math.round(Math.max(0, Math.min(1, ShellState.windowShadowOpacity)) * 255).toString(16)
        if (a.length < 2) a = "0" + a
        return "rgba(" + hex + a + ")"
    }

    function _configLua() {
        return "hl.config({\n"
            + "    general = {\n"
            + "        gaps_in = " + Math.round(ShellState.windowGapsIn) + ",\n"
            + "        gaps_out = " + Math.round(ShellState.windowGapsOut) + ",\n"
            + "        border_size = " + Math.round(ShellState.windowBorderSize) + ",\n"
            + "    },\n"
            + "    decoration = {\n"
            + "        rounding = " + Math.round(ShellState.windowRounding) + ",\n"
            + "        rounding_power = " + root._num(ShellState.windowRoundingPower) + ",\n"
            + "        active_opacity = " + root._num(ShellState.windowActiveOpacity) + ",\n"
            + "        inactive_opacity = " + root._num(ShellState.windowInactiveOpacity) + ",\n"
            + "        fullscreen_opacity = " + root._num(ShellState.windowFullscreenOpacity) + ",\n"
            + "        dim_inactive = " + root._bool(ShellState.windowDimInactive) + ",\n"
            + "        dim_strength = " + root._num(ShellState.windowDimStrength) + ",\n"
            + "        shadow = {\n"
            + "            enabled = " + root._bool(ShellState.windowShadowEnabled) + ",\n"
            + "            range = " + Math.round(ShellState.windowShadowRange) + ",\n"
            + "            render_power = " + Math.round(ShellState.windowShadowPower) + ",\n"
            + "            scale = " + root._num(ShellState.windowShadowScale) + ",\n"
            + "            color = \"" + root._shadowRgba() + "\",\n"
            + "        },\n"
            + "    },\n"
            + "})\n"
    }

    function _render() {
        return "-- Generated by Hermit (Settings > Appearance > Surfaces and Windows). Edit it there; changes here are overwritten.\n"
            + root._configLua()
    }

    function _apply() {
        const lua = root._render()
        if (lua === root._written) return
        root._written = lua
        file.setText(lua)
        root._eval()
    }

    function _eval() {
        if (evalProc.running) {
            root._evalPending = true
            return
        }
        evalProc.command = ["hyprctl", "eval", root._configLua()]
        evalProc.running = true
    }

    Timer {
        id: applyTimer
        interval: 150
        repeat: false
        onTriggered: root._apply()
    }

    // Only used if `hyprctl eval` fails. The file is already written, so a reload applies it.
    Timer {
        id: reloadTimer
        interval: 450
        repeat: false
        onTriggered: {
            reloadProc.command = ["hyprctl", "reload"]
            reloadProc.running = true
        }
    }

    Process {
        id: evalProc
        onExited: (exitCode, exitStatus) => {
            if (exitCode !== 0) reloadTimer.restart()
            if (root._evalPending) {
                root._evalPending = false
                root._eval()
            }
        }
    }

    Process { id: reloadProc }

    FileView {
        id: file
        path: root.path
        printErrors: false
        onLoaded: {
            root._written = file.text()
            root._fileLoaded = true
        }
        onLoadFailed: (error) => {
            root._written = ""
            root._fileLoaded = true
        }
    }

    Component.onCompleted: Quickshell.execDetached(["mkdir", "-p", root.dir])
}