// features/hyprland/BlurService.qml — writes Surfaces > Blur to Hyprland.
// ShellState holds the values. This turns them into modules/decoration/blur.lua (loaded by
// Hyprland at startup) and pushes the plain config values to the running compositor with
// `hyprctl eval`, so sliders feel live. Only a change to the island/window rules needs a
// `hyprctl reload`. blur.lua is the only place blur is defined — never edit it by hand.
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import "../../core/shell"
import "../settings/core"

Item {
    id: root

    readonly property string dir: Quickshell.env("HOME") + "/.config/hypr/modules/decoration"
    readonly property string path: root.dir + "/blur.lua"
    readonly property string rulesMarker: "-- [rules]\n"
    readonly property string islandNamespace: "quickshell:island"

    // Nothing is written until blur.lua has been read AND SettingsStore has loaded the saved
    // values, so the defaults never reach Hyprland for a moment at startup.
    property bool _fileLoaded: false
    readonly property bool _ready: root._fileLoaded && SettingsStore._loaded
    property string _written: ""
    property bool _evalPending: false

    // Every value that ends up in blur.lua. Any change schedules a debounced apply.
    readonly property string signature: [
        ShellState.blurAnyActive, ShellState.blurWindowsActive, ShellState.blurIslandActive,
        ShellState.blurIslandCutoff, ShellState.blurSize, ShellState.blurPasses,
        ShellState.blurNoise, ShellState.blurContrast, ShellState.blurBrightness,
        ShellState.blurVibrancy, ShellState.blurVibrancyDarkness,
        ShellState.blurIgnoreOpacity, ShellState.blurXray, ShellState.blurOptimizations,
        ShellState.blurPopups
    ].join("|")

    onSignatureChanged: root._schedule()
    on_ReadyChanged: if (root._ready) root._schedule()

    function _schedule() {
        if (root._ready) applyTimer.restart()
    }

    // Lua wants 0.0 style floats for float options.
    function _num(v) {
        const s = Number(Number(v).toFixed(4)).toString()
        return s.indexOf(".") < 0 ? s + ".0" : s
    }

    function _bool(v) { return v ? "true" : "false" }

    function _configLua() {
        return "hl.config({\n"
            + "    decoration = {\n"
            + "        blur = {\n"
            + "            enabled = " + root._bool(ShellState.blurAnyActive) + ",\n"
            + "            size = " + Math.round(ShellState.blurSize) + ",\n"
            + "            passes = " + Math.round(ShellState.blurPasses) + ",\n"
            + "            noise = " + root._num(ShellState.blurNoise) + ",\n"
            + "            contrast = " + root._num(ShellState.blurContrast) + ",\n"
            + "            brightness = " + root._num(ShellState.blurBrightness) + ",\n"
            + "            vibrancy = " + root._num(ShellState.blurVibrancy) + ",\n"
            + "            vibrancy_darkness = " + root._num(ShellState.blurVibrancyDarkness) + ",\n"
            + "            ignore_opacity = " + root._bool(ShellState.blurIgnoreOpacity) + ",\n"
            + "            xray = " + root._bool(ShellState.blurXray) + ",\n"
            + "            new_optimizations = " + root._bool(ShellState.blurOptimizations) + ",\n"
            + "            popups = " + root._bool(ShellState.blurPopups) + ",\n"
            + "        },\n"
            + "    },\n"
            + "})\n"
    }

    // Per-target switches. The island is a layer rule; windows are a catch-all no_blur rule
    // (blur itself stays globally enabled whenever either target wants it).
    function _rulesLua() {
        return root.rulesMarker
            + "hl.layer_rule({\n"
            + "    name = \"island-blur\",\n"
            + "    match = { namespace = \"" + root.islandNamespace + "\" },\n"
            + "    blur = " + root._bool(ShellState.blurIslandActive) + ",\n"
            + "    ignore_alpha = " + root._num(ShellState.blurIslandCutoff) + ",\n"
            + "})\n\n"
            + "hl.window_rule({\n"
            + "    name = \"windows-no-blur\",\n"
            + "    match = { class = \".*\" },\n"
            + "    no_blur = " + root._bool(!ShellState.blurWindowsActive) + ",\n"
            + "})\n"
    }

    function _render() {
        return "-- Generated by the Quickshell shell (Settings > Appearance > Surfaces > Blur). Edit it there; changes here are overwritten.\n"
            + root._configLua() + "\n" + root._rulesLua()
    }

    function _rulesPart(s) {
        const i = s.indexOf(root.rulesMarker)
        return i < 0 ? "" : s.substring(i)
    }

    function _apply() {
        const lua = root._render()
        if (lua === root._written) return
        const rulesChanged = root._rulesPart(lua) !== root._rulesPart(root._written)
        root._written = lua
        file.setText(lua)
        root._eval()
        if (rulesChanged) reloadTimer.restart()
    }

    function _eval() {
        if (evalProc.running) {
            root._evalPending = true
            return
        }
        evalProc.command = ["hyprctl", "eval", root._configLua()]
        evalProc.running = true
    }

    Timer {
        id: applyTimer
        interval: 150
        repeat: false
        onTriggered: root._apply()
    }

    // Rules can't be changed live, so they need a reload. Waits for the sliders to go quiet.
    Timer {
        id: reloadTimer
        interval: 450
        repeat: false
        onTriggered: {
            reloadProc.command = ["hyprctl", "reload"]
            reloadProc.running = true
        }
    }

    Process {
        id: evalProc
        // If eval is unsupported or fails, the file is already written, so a reload applies it.
        onExited: (exitCode, exitStatus) => {
            if (exitCode !== 0) reloadTimer.restart()
            if (root._evalPending) {
                root._evalPending = false
                root._eval()
            }
        }
    }

    Process { id: reloadProc }

    FileView {
        id: file
        path: root.path
        printErrors: false
        onLoaded: {
            root._written = file.text()
            root._fileLoaded = true
        }
        onLoadFailed: (error) => {
            root._written = ""
            root._fileLoaded = true
        }
    }

    Component.onCompleted: Quickshell.execDetached(["mkdir", "-p", root.dir])
}