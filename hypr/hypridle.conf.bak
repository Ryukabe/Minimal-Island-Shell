general {
    lock_cmd = qs ipc call lock lock
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch dpms on
}

listener {
    timeout = 150
    on-timeout = ags request "brightness-silent"; brightnessctl -s set 0
    on-resume = ags request "brightness-silent"; brightnessctl -r
}

listener {
    timeout = 300
    on-timeout = loginctl lock-session          # this triggers lock_cmd above
}

listener {
    timeout = 330
    on-timeout = hyprctl dispatch dpms off
    on-resume = ags request "brightness-silent"; hyprctl dispatch dpms on && brightnessctl -r
}

listener {
    timeout = 1800
    on-timeout = systemctl suspend
}